@model IEnumerable<ofis_ici_yemek_secim_sistemi.Models.StockItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Stok Yönetimi";
    var recentMovements = ViewBag.RecentMovements as List<ofis_ici_yemek_secim_sistemi.Controllers.StockMovementView>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Stok Yönetimi</h3>
        <p class="text-muted small m-0">Mutfakta kullanılan malzeme ve ham madde stoklarını takip edin.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-print no-print" onclick="printPage()" title="Listeyi yazdır">
            <i class="fa-solid fa-print"></i> Yazdır
        </button>
        <a href="@Url.Action("AddStock", "Stock")"
           class="btn btn-primary fw-semibold px-4 py-2 btn-add-ajax"
           data-title="Yeni Stok Kalemi"
           style="border-radius:8px;">
            <i class="fa-solid fa-plus me-2"></i>Yeni Stok Kalemi
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4" style="border-radius:12px;">
    <div class="card-body py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold small">Arama</label>
                <div class="input-group">
                    <span class="input-group-text bg-white" style="border-radius:8px 0 0 8px;">
                        <i class="fa-solid fa-search text-muted"></i>
                    </span>
                    <input type="text" id="stockSearchInput" class="form-control py-2"
                           placeholder="Malzeme adı veya kategori..." style="border-radius:0 8px 8px 0;">
                </div>
            </div>
        </div>
    </div>
</div>

<div id="tableContainer"
     data-refresh-url="@Url.Action("StockManagement", "Stock")"
     data-secondary-url="@Url.Action("RecentMovements", "Stock")"
     data-secondary-target="#recentMovementsPanel">
    @Html.Partial("_StockList", Model)
</div>


<div class="card shadow-sm border-0 mt-4 no-print" style="border-radius:12px;">
    <div class="card-body">
        <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-clock-rotate-left text-muted me-1"></i>Son Stok Hareketleri</h6>
        <div id="recentMovementsPanel">
            @Html.Partial("_RecentMovements", recentMovements)
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            initDataTable('#stockTable');

            $('#stockSearchInput').on('keyup', function () {
                $('#stockTable').DataTable().search($(this).val()).draw();
            });

            $(document).on('click', '.btn-delete-stock', function (e) {
                e.preventDefault();
                var form = $(this).closest('form');
                var name = $(this).data('name');

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "'" + name + "' stok kalemini silmek (pasife almak) istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Evet, Sil',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: form.attr('action'),
                            type: 'POST',
                            data: form.serialize(),
                            success: function (response) {
                                if (response.success) {
                                    toastr.success(response.message);
                                    AjaxModal.refreshTable();
                                } else {
                                    toastr.error(response.message);
                                }
                            },
                            error: function () {
                                toastr.error('Silme işlemi sırasında hata oluştu.');
                            }
                        });
                    }
                });
            });

            $(document).on('click', '.btn-toggle-status', function (e) {
                e.preventDefault();
                var form = $(this).closest('form');
                var isActive = $(this).data('active') === true || $(this).data('active') === 'true';
                var newStatus = isActive ? 'pasif' : 'aktif';

                Swal.fire({
                    title: 'Durumu Değiştir',
                    text: "Bu stok kalemini " + newStatus + " hale getirmek istediğinize emin misiniz?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3b82f6',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Evet, Değiştir',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: form.attr('action'),
                            type: 'POST',
                            data: form.serialize(),
                            success: function (response) {
                                if (response.success) {
                                    toastr.success(response.message);
                                    AjaxModal.refreshTable();
                                } else {
                                    toastr.error(response.message);
                                }
                            },
                            error: function () {
                                toastr.error('Durum değiştirilirken hata oluştu.');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
