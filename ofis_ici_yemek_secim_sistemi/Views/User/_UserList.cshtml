@model IEnumerable<ofis_ici_yemek_secim_sistemi.Models.User>
@{
    string currentUserEmail = User.Identity.Name;
}

<div class="card shadow-sm border-0" style="border-radius:12px;">
    <div class="table-responsive">
        @if (Model != null && Model.Any())
        {
            <table id="userTable" class="table table-hover align-middle mb-0 table-datatable" style="width:100%;">
                <thead class="table-light">
                    <tr>
                        <th style="padding:1rem 1.5rem;">Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Departman</th>
                        <th>Lokasyon</th>
                        <th>Durum</th>
                        <th style="min-width:100px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        bool isCurrentUser = (user.Email == currentUserEmail);
                        <tr class="@(!user.IsActive ? "table-secondary opacity-75" : "")">
                            <td style="padding:1rem 1.5rem;" class="fw-semibold text-dark">@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @(user.Role == "Admin" ? "bg-primary-subtle text-primary" : "bg-secondary-subtle text-secondary") px-2 py-1" style="border-radius:6px;">
                                    @user.Role
                                </span>
                            </td>
                            <td>@(string.IsNullOrEmpty(user.Department) ? "—" : user.Department)</td>
                            <td>@(string.IsNullOrEmpty(user.Location) ? "—" : user.Location)</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius:6px;">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="border-radius:6px;">Pasif</span>
                                }
                            </td>
                            <td>
                                @if (!isCurrentUser)
                                {
                                    <div class="d-flex gap-2">
                                        @using (Html.BeginForm("ToggleUserStatus", "User", new { id = user.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-row-action btn-toggle-status"
                                                    data-active="@user.IsActive.ToString().ToLower()"
                                                    title="@(user.IsActive ? "Pasife Al" : "Aktif Et")">
                                                <i class="fa-solid fa-power-off"></i>
                                                <span class="btn-action-text">@(user.IsActive ? "Pasife Al" : "Aktif Et")</span>
                                            </button>
                                        }
                                        @using (Html.BeginForm("DeleteUser", "User", new { id = user.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-row-action btn-delete-user"
                                                    data-name="@user.Name"
                                                    title="Kullanıcıyı Sil">
                                                <i class="fa-solid fa-trash"></i>
                                                <span class="btn-action-text">Sil</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">(Siz)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state-block text-center py-5">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-users fs-1 text-muted opacity-50"></i>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <h5 class="fw-bold text-dark">Sonuç bulunamadı</h5>
                    <p class="text-muted mb-3">Aramanızla eşleşen kullanıcı bulunamadı.</p>
                }
                else
                {
                    <h5 class="fw-bold text-dark">Henüz kullanıcı eklenmemiş</h5>
                    <p class="text-muted mb-3">Şirketinize ilk kullanıcıyı ekleyerek başlayın.</p>
                    <button type="button" class="btn btn-primary btn-empty-add"
                            data-url="@Url.Action("AddUser", "User")" data-title="Yeni Kullanıcı Ekle">
                        <i class="fa-solid fa-plus me-2"></i>Eklenecek yerler
                    </button>
                }
            </div>
        }
    </div>
</div>
