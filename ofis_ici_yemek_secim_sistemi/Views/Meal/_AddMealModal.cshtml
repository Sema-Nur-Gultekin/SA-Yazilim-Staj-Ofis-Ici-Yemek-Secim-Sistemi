@model ofis_ici_yemek_secim_sistemi.Models.MealType

<form action="@Url.Action("AddMeal", "Meal")" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold">Öğün Adı <span class="text-danger">*</span></label>
        <input type="text" name="Name" class="form-control py-2" placeholder="Örn: Kahvaltı, Ara Öğün" required maxlength="20" style="border-radius:8px;" />
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold">Görüntüleme Sırası</label>
        <input type="number" name="DisplayOrder" class="form-control py-2" placeholder="Örn: 1" min="1" style="border-radius:8px;" />
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="btn btn-primary" data-original-text="<i class='fa-solid fa-floppy-disk me-1'></i>Kaydet">
            <i class="fa-solid fa-floppy-disk me-1"></i>Kaydet
        </button>
    </div>
</form>
