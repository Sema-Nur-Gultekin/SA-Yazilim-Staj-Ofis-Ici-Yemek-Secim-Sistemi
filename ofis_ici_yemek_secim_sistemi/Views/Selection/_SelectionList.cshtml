@model IEnumerable<ofis_ici_yemek_secim_sistemi.Models.Selection>
@{
    var userNames = ViewBag.UserNames as Dictionary<int, string>;
    var foodNames = ViewBag.FoodNames as Dictionary<int, string>;
    var menuDict = ViewBag.MenuDict as Dictionary<int, (DateTime Date, string MealType, int FoodID)>;

    var grouped = Model
        .GroupBy(s => new
        {
            s.UserID,
            Date = menuDict.ContainsKey(s.MenuItemID) ? (DateTime?)menuDict[s.MenuItemID].Date : null,
            MealType = menuDict.ContainsKey(s.MenuItemID) ? menuDict[s.MenuItemID].MealType : ""
        })
        .Select(g => new
        {
            UserID = g.Key.UserID,
            UserName = userNames != null && userNames.ContainsKey(g.Key.UserID) ? userNames[g.Key.UserID] : "Bilinmeyen",
            Date = g.Key.Date,
            MealType = g.Key.MealType,
            FoodList = string.Join(", ", g.Select(s =>
            {
                if (menuDict.ContainsKey(s.MenuItemID))
                {
                    var menu = menuDict[s.MenuItemID];
                    return foodNames != null && foodNames.ContainsKey(menu.FoodID) ? foodNames[menu.FoodID] : "?";
                }
                return "?";
            })),
            SelectionIDs = g.Select(s => s.ID).ToList()
        })
        .OrderByDescending(g => g.Date)
        .ThenBy(g => g.UserName)
        .ToList();
}

<div class="card shadow-sm border-0" style="border-radius:12px;">
    <div class="table-responsive">
        @if (grouped.Any())
        {
            <table id="selectionTable" class="table table-hover align-middle mb-0 table-datatable" style="width:100%;">
                <thead class="table-light">
                    <tr>
                        <th style="padding:1rem 1.5rem;">Tarih</th>
                        <th>Öğün</th>
                        <th>Personel</th>
                        <th>Seçilen Yemekler</th>
                        <th style="min-width:80px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in grouped)
                    {
                        <tr>
                            <td style="padding:1rem 1.5rem;" class="fw-semibold">@(group.Date.HasValue ? group.Date.Value.ToString("dd.MM.yyyy") : "-")</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="border-radius:6px;">@group.MealType</span>
                            </td>
                            <td>@group.UserName</td>
                            <td class="text-dark">@group.FoodList</td>
                            <td>
                                @using (Html.BeginForm("DeleteSelectionGroup", "Selection", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ids" value="@string.Join(",", group.SelectionIDs)" />
                                    <button type="button"
                                            class="btn btn-outline-primary btn-row-action btn-delete-selection-group"
                                            data-user="@group.UserName"
                                            data-date="@(group.Date.HasValue ? group.Date.Value.ToString("dd.MM.yyyy") : "")"
                                            data-meal="@group.MealType"
                                            title="Tüm seçimleri sil">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state-block text-center py-5">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-clipboard-list fs-1 text-muted opacity-50"></i>
                </div>
                <h5 class="fw-bold text-dark">Kayıt Bulunamadı</h5>
                <p class="text-muted">Henüz hiçbir personel seçim yapmamış veya filtrenizle eşleşen kayıt yok.</p>
            </div>
        }
    </div>
</div>

@{
    var nonSelectors = ViewBag.NonSelectors as List<ofis_ici_yemek_secim_sistemi.Models.User>;
    bool hasMenuInRange = ViewBag.HasMenuInRange != null && (bool)ViewBag.HasMenuInRange;
    DateTime nsFrom = ViewBag.NonSelectorsFrom;
    DateTime nsTo = ViewBag.NonSelectorsTo;
    string rangeLabel = nsFrom == nsTo ? nsFrom.ToString("dd.MM.yyyy") : $"{nsFrom:dd.MM.yyyy} - {nsTo:dd.MM.yyyy}";
}


@if (hasMenuInRange)
{
    <div class="card shadow-sm border-0 mt-4" style="border-radius:12px;">
        <div class="card-body">
            <h6 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-triangle-exclamation text-warning me-1"></i>
                Seçim Yapmayan Personel <span class="text-muted fw-normal">(@rangeLabel)</span>
            </h6>
            @if (nonSelectors != null && nonSelectors.Any())
            {
                <p class="text-muted small mb-3">Aşağıdaki personel, bu tarih aralığında aktif menü olmasına rağmen henüz yemek seçimi yapmadı.</p>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var u in nonSelectors)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2" style="border-radius:8px; font-size:0.85rem;">
                            <i class="fa-solid fa-user me-1"></i>@u.Name
                            @if (!string.IsNullOrWhiteSpace(u.Department))
                            {
                                <span class="text-muted">(@u.Department)</span>
                            }
                        </span>
                    }
                </div>
            }
            else
            {
                <p class="text-success small mb-0"><i class="fa-solid fa-circle-check me-1"></i>Bu tarih aralığında tüm personel seçimini yapmış.</p>
            }
        </div>
    </div>
}
