@model IEnumerable<ofis_ici_yemek_secim_sistemi.Models.Food>
@{
    var categories = ViewBag.Categories as Dictionary<int, string>;
}

<div class="card shadow-sm border-0" style="border-radius:12px;">
    <div class="table-responsive">
        @if (Model != null && Model.Any())
        {
            <table id="foodTable" class="table table-hover align-middle mb-0 table-datatable" style="width:100%;">
                <thead class="table-light">
                    <tr>
                        <th style="width:56px;">Görsel</th>
                        <th style="padding:1rem 1.5rem;">Yemek Adı</th>
                        <th>Kategori</th>
                        <th>İçindekiler</th>
                        <th>Açıklama</th>
                        <th>Alerjen</th>
                        <th>Durum</th>
                        <th style="min-width:150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.IsActive ? "table-secondary opacity-75" : "")">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                {
                                    <img src="@Url.Content(item.ImagePath)" alt="@item.Name" style="width:40px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #e2e8f0;" />
                                }
                                else
                                {
                                    <div style="width:40px;height:40px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;color:#94a3b8;">
                                        <i class="fa-solid fa-utensils" style="font-size:0.9rem;"></i>
                                    </div>
                                }
                            </td>
                            <td style="padding:1rem 1.5rem;" class="fw-semibold text-dark">@item.Name</td>
                            <td>
                                @if (item.CategoryID.HasValue && categories != null && categories.ContainsKey(item.CategoryID.Value))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" style="border-radius:6px;">
                                        @categories[item.CategoryID.Value]
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrEmpty(item.Ingredients) ? "—" : (item.Ingredients.Length > 60 ? item.Ingredients.Substring(0, 60) + "..." : item.Ingredients))
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrEmpty(item.Description) ? "—" : (item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description))
                            </td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(item.Allergens) ? "—" : item.Allergens)</td>
                            <td>
                               
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius:6px;">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" style="border-radius:6px;">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="@Url.Action("EditFood", "Food", new { id = item.ID })"
                                       class="btn btn-outline-primary btn-row-action btn-edit-ajax"
                                       data-title="Yemek Düzenle"
                                       title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span class="btn-action-text">Düzenle</span>
                                    </a>
                                    @using (Html.BeginForm("ToggleFoodStatus", "Food", new { id = item.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="button"
                                                class="btn btn-outline-primary btn-row-action btn-toggle-status"
                                                data-active="@item.IsActive.ToString().ToLower()"
                                                title="@(item.IsActive ? "Pasife Al" : "Aktif Et")">
                                            <i class="fa-solid fa-power-off"></i>
                                            <span class="btn-action-text">@(item.IsActive ? "Pasife Al" : "Aktif Et")</span>
                                        </button>
                                    }
                                    @using (Html.BeginForm("DeleteFood", "Food", new { id = item.ID }, FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="button"
                                                class="btn btn-outline-primary btn-row-action btn-delete-food"
                                                data-name="@item.Name"
                                                title="Sil">
                                            <i class="fa-solid fa-trash"></i>
                                            <span class="btn-action-text">Sil</span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state-block text-center py-5">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-bowl-food fs-1 text-muted opacity-50"></i>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <h5 class="fw-bold text-dark">Sonuç bulunamadı</h5>
                    <p class="text-muted mb-3">Aramanızla eşleşen yemek bulunamadı.</p>
                }
                else
                {
                    <h5 class="fw-bold text-dark">Henüz yemek eklenmemiş</h5>
                    <p class="text-muted mb-3">Kataloğunuza ilk yemeği ekleyerek başlayın.</p>
                    <button type="button" class="btn btn-primary btn-empty-add"
                            data-url="@Url.Action("AddFood", "Food")" data-title="Yeni Yemek Tanımla">
                        <i class="fa-solid fa-plus me-2"></i>Eklenecek yerler
                    </button>
                }
            </div>
        }
    </div>

    @{
        int currentPage = ViewBag.CurrentPage ?? 1;
        int totalPages = ViewBag.TotalPages ?? 1;
        int totalCount = ViewBag.TotalCount ?? 0;
    }
    
    @if (totalCount > 0)
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 px-3 py-3 border-top no-print">
            <span class="text-muted small">Toplam @totalCount kayıt — Sayfa @currentPage / @totalPages</span>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="foodPagination">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(currentPage - 1)">Önceki</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" href="#" data-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="#" data-page="@(currentPage + 1)">Sonraki</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
